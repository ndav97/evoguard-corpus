{
  "name": "evoguard-corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Especificación ejecutable del corpus EvoGuard; no contiene V0.",
  "scripts": {
    "corpus:validate": "node runner/validation/cli.mjs",
    "family:validate": "node runner/validation/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "packet:preview": "node runner/packet-cli.mjs",
    "generation:preflight": "node runner/preflight.mjs",
    "scaffold:build": "npm --prefix templates/react-vite run build",
    "check": "npm run corpus:validate && npm test && npm run scaffold:build",
    "environment:build": "node runner/sandbox/build.mjs",
    "environment:verify": "node runner/sandbox/verify.mjs",
    "sandbox": "node runner/sandbox/cli.mjs",
    "runner:simulate": "node runner/simulation/cli.mjs",
    "providers": "node --env-file-if-exists=.env runner/providers/cli.mjs",
    "providers:diagnose": "node --env-file-if-exists=.env runner/providers/cli.mjs diagnose",
    "context:calibrate": "node runner/context/calibrate.mjs",
    "pipeline:rehearse": "node runner/pipeline/rehearse.mjs",
    "corpus:generate": "node --env-file-if-exists=.env runner/pipeline/generate.mjs",
    "corpus:audit": "node runner/pipeline/audit.mjs",
    "bench:local": "node runner/bench/local.mjs",
    "bench:selftest": "node runner/bench/selftest.mjs V0,V1,V2,V3",
    "oracle:lock": "node runner/oracle/lock.mjs",
    "test:calibration": "node --test tests/calibration/*.test.mjs",
    "real:prepare": "node runner/real/prepare.mjs",
    "real:rehearse": "node runner/real/rehearse.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
