+import { describe, it, expect } from 'vitest';
+import { filterProducts } from './utils';
+
+describe('filterProducts', () => {
+  const products = [
+    { id: 'P001', name: 'Wireless Mouse', category: 'Electronics', price: 24.99 },
+    { id: 'P010', name: 'Desk Lamp', category: 'Home', price: 34.5 },
+    { id: 'P018', name: 'Running Shoes', category: 'Sports', price: 79.99 },
+  ];
+
+  it('filters by category', () => {
+    expect(filterProducts(products, '', 'Home')).toHaveLength(1);
+    expect(filterProducts(products, '', 'Home')[0].id).toBe('P010');
+  });
+
+  it('filters by name', () => {
+    expect(filterProducts(products, 'mouse', 'All')).toHaveLength(1);
+    expect(filterProducts(products, '  MoUsE  ', 'All')).toHaveLength(1);
+  });
+});
