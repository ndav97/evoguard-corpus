+import { describe, it, expect } from 'vitest';
+import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import App from './App';
+
+describe('Product Catalog', () => {
+  describe('R001: Search by name', () => {
+    it('R001-A01: Partial match returns corresponding products', async () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      await userEvent.type(searchInput, 'Mouse');
+      expect(screen.getByText(/P001 Wireless Mouse/)).toBeInTheDocument();
+    });
+
+    it('R001-A02: Search is case-insensitive', async () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      await userEvent.type(searchInput, 'MOUSE');
+      expect(screen.getByText(/P001 Wireless Mouse/)).toBeInTheDocument();
+    });
+
+    it('R001-A03: Leading and trailing spaces are trimmed', async () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      await userEvent.type(searchInput, '  Mouse  ');
+      expect(screen.getByText(/P001 Wireless Mouse/)).toBeInTheDocument();
+    });
+
+    it('R001-A04: Empty query disables search and keeps other filters', async () => {
+      render(<App />);
+      const items = screen.getAllByRole('listitem');
+      expect(items.length).toBe(30);
+    });
+
+    it('R001-A05: Search combined with category filter', async () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      const categorySelect = screen.getByLabelText('Categoría');
+      
+      await userEvent.selectOptions(categorySelect, 'Electronics');
+      await userEvent.type(searchInput, 'Mouse');
+      
+      expect(screen.getByText(/P001 Wireless Mouse/)).toBeInTheDocument();
+      expect(screen.queryByText(/P018 Running Shoes/)).not.toBeInTheDocument();
+    });
+  });
+
+  describe('R002: Filter by category', () => {
+    it('R002-A01: All does not exclude products by category', () => {
+      render(<App />);
+      const items = screen.getAllByRole('listitem');
+      expect(items.length).toBe(30);
+    });
+
+    it('R002-A02: Each category shows only its products', async () => {
+      render(<App />);
+      const categorySelect = screen.getByLabelText('Categoría');
+      
+      await userEvent.selectOptions(categorySelect, 'Electronics');
+      const electronicsItems = screen.getAllByRole('listitem');
+      expect(electronicsItems.length).toBe(9);
+      
+      await userEvent.selectOptions(categorySelect, 'Home');
+      const homeItems = screen.getAllByRole('listitem');
+      expect(homeItems.length).toBe(8);
+      
+      await userEvent.selectOptions(categorySelect, 'Sports');
+      const sportsItems = screen.getAllByRole('listitem');
+      expect(sportsItems.length).toBe(7);
+      
+      await userEvent.selectOptions(categorySelect, 'Books');
+      const booksItems = screen.getAllByRole('listitem');
+      expect(booksItems.length).toBe(6);
+    });
+
+    it('R002-A03: Category change updates results immediately', async () => {
+      render(<App />);
+      const categorySelect = screen.getByLabelText('Categoría');
+      
+      await userEvent.selectOptions(categorySelect, 'Books');
+      expect(screen.getByText(/P025 Clean Code/)).toBeInTheDocument();
+      expect(screen.queryByText(/P001 Wireless Mouse/)).not.toBeInTheDocument();
+    });
+
+    it('R002-A04: Search and category applied together', async () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      const categorySelect = screen.getByLabelText('Categoría');
+      
+      await userEvent.type(searchInput, 'Bottle');
+      await userEvent.selectOptions(categorySelect, 'Home');
+      
+      expect(screen.getByText(/P013 Glass Bottle/)).toBeInTheDocument();
+      expect(screen.queryByText(/P022 Sports Bottle/)).not.toBeInTheDocument();
+    });
+
+    it('R002-A05: Empty results show no incorrect products', async () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      const categorySelect = screen.getByLabelText('Categoría');
+      
+      await userEvent.selectOptions(categorySelect, 'Books');
+      await userEvent.type(searchInput, 'Wireless');
+      
+      expect(screen.queryByRole('listitem')).not.toBeInTheDocument();
+      expect(screen.getByText('No se encontraron productos')).toBeInTheDocument();
+    });
+  });
+
+  describe('UI Contract', () => {
+    it('Initial state: search is empty and category is All', () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar') as HTMLInputElement;
+      const categorySelect = screen.getByLabelText('Categoría') as HTMLSelectElement;
+      
+      expect(searchInput.value).toBe('');
+      expect(categorySelect.value).toBe('All');
+    });
+
+    it('Search input is type="search"', () => {
+      render(<App />);
+      const searchInput = screen.getByLabelText('Buscar');
+      expect(searchInput).toHaveAttribute('type', 'search');
+    });
+
+    it('Category select has exact options', () => {
+      render(<App />);
+      const categorySelect = screen.getByLabelText('Categoría');
+      const options = Array.from(categorySelect.querySelectorAll('option')).map(o => o.value);
+      expect(options).toEqual(['All', 'Electronics', 'Home', 'Sports', 'Books']);
+    });
+
+    it('Products displayed as list items with ID and name', () => {
+      render(<App />);
+      const firstItem = screen.getByText(/P001 Wireless Mouse/);
+      expect(firstItem.tagName).toBe('LI');
+    });
+  });
+});
