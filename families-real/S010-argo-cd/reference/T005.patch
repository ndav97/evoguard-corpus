+// Aplicaciones por proyecto: "nombre (N)" de más a menos aplicaciones (empates por nombre), como máximo 5, y "+K more".
+export const projectsTooltip = (apps: models.Application[]) => {
+    const counts = new Map<string, number>();
+    apps.forEach(app => {
+        const project = app.spec?.project || 'default';
+        counts.set(project, (counts.get(project) || 0) + 1);
+    });
+    const entries = Array.from(counts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
+    const shown = entries
+        .slice(0, 5)
+        .map(([name, count]) => `${name} (${count})`)
+        .join(', ');
+    return entries.length > 5 ? `${shown}, +${entries.length - 5} more` : shown;
+};
