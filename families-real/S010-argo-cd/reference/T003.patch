+// Una aplicación necesita atención si está OutOfSync o su salud es Degraded o Missing (se cuenta una vez).
+export const needsAttention = (app: models.Application) =>
+    app.status.sync.status === 'OutOfSync' || app.status.health.status === 'Degraded' || app.status.health.status === 'Missing';
+
+// Nombres ordenados alfabéticamente, como máximo 5, y "+K more" si hay más.
+export const attentionTooltip = (apps: models.Application[]) => {
+    const names = apps.map(app => app.metadata?.name ?? '').sort((a, b) => a.localeCompare(b));
+    const shown = names.slice(0, 5).join(', ');
+    return names.length > 5 ? `${shown}, +${names.length - 5} more` : shown;
+};
