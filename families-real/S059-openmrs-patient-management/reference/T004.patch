+
+/**
+ * Average wait, in minutes, of the patients that started waiting at `startTimes`; entries whose
+ * start is missing or invalid are ignored. Returns null if no entry has a valid start.
+ */
+export function getAverageWaitTimeInMinutes(
+  startTimes: ReadonlyArray<Date | string | number | null | undefined> | null | undefined,
+  now: Date | string | number = new Date(),
+): number | null {
+  const waits = (startTimes ?? [])
+    .map((startedAt) => getWaitTimeInMinutes(startedAt, now))
+    .filter((minutes): minutes is number => minutes !== null);
+
+  if (!waits.length) {
+    return null;
+  }
+
+  return waits.reduce((sum, minutes) => sum + minutes, 0) / waits.length;
+}
