+
+/**
+ * Compact wait time for narrow places such as table cells: "7m", "1h 48m", "2h", "1d 6h", "3d".
+ * Shows at most two units (days and hours from one day on), and the same placeholder and
+ * rounding rules as formatWaitTimeInMinutes.
+ */
+export function formatWaitTimeShort(minutes: number | null | undefined) {
+  if (typeof minutes !== 'number' || !Number.isFinite(minutes)) {
+    return WAIT_TIME_PLACEHOLDER;
+  }
+
+  const totalMinutes = Math.max(Math.round(minutes), 0);
+  const days = Math.floor(totalMinutes / minutesPerDay);
+  const hours = Math.floor((totalMinutes % minutesPerDay) / minutesPerHour);
+  const remainingMinutes = totalMinutes % minutesPerHour;
+
+  if (days > 0) {
+    return hours > 0 ? `${days}d ${hours}h` : `${days}d`;
+  }
+  if (hours > 0) {
+    return remainingMinutes > 0 ? `${hours}h ${remainingMinutes}m` : `${hours}h`;
+  }
+  return `${remainingMinutes}m`;
+}
