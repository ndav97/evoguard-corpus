+/**
+ * Converts a whole number-like string to a comma separated value.
+ * Values with a fractional part are invalid and returned as entered.
+ * @param {String} value
+ * @returns {MaskedValue}
+ */
+export function convertToThousandsSeparatedIntegerString(
+  value: string
+): MaskedValue {
+  const cleanedInput = cleanStandardNumericalInput(value);
+  if (!cleanedInput.isValid || cleanedInput.cleanedValue === "")
+    return { isValid: false, maskedValue: value };
+
+  const numericValue = Number(cleanedInput.cleanedValue);
+  if (!Number.isInteger(numericValue))
+    return { isValid: false, maskedValue: value };
+
+  return convertToThousandsSeparatedString(cleanedInput.cleanedValue, 0);
+}
