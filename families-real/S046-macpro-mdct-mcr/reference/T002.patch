+const suffixMultipliers: Record<string, number> = { k: 3, m: 6, b: 9 };
+
+/**
+ * Expands a trailing k/M/B abbreviation ("1.5k" -> "1500") without floating
+ * point arithmetic. Values without a suffix are returned unchanged.
+ * @param {String} value
+ * @returns {String}
+ */
+export function expandAbbreviatedNumber(value: string): string {
+  const match = /^(\$?-?)([\d,]*\.?\d+)\s*([kmb])$/i.exec(value.trim());
+  if (!match) return value;
+
+  const [, prefix, number, suffix] = match;
+  const zeros = suffixMultipliers[suffix.toLowerCase()];
+  const [whole, fraction = ""] = number.replaceAll(",", "").split(".");
+  const shiftedFraction = fraction.padEnd(zeros, "0");
+  const expanded = (
+    whole +
+    shiftedFraction.slice(0, zeros) +
+    (shiftedFraction.length > zeros ? "." + shiftedFraction.slice(zeros) : "")
+  ).replace(/^0+(?=\d)/, "");
+  return prefix + expanded;
+}
