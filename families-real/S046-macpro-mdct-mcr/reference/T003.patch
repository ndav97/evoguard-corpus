+/**
+ * Accounting notation: "(1,234)" or "($1,234)" means a negative amount.
+ * Returns the value with a leading minus sign instead of the parentheses.
+ * @param {String} value
+ * @returns {String}
+ */
+export function convertParenthesesToNegative(value: string): string {
+  const match = /^\(\s*(\$?)\s*([^()$\s-][^()]*?)\s*\)$/.exec(value.trim());
+  if (!match) return value;
+  const [, dollar, number] = match;
+  return dollar + "-" + number;
+}
+
+const prepareNumericInput = (value: string) =>
+  expandAbbreviatedNumber(convertParenthesesToNegative(value));
