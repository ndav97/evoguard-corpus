+const getRequirements = (password: string, policy: PasswordPolicyConfiguration) => {
+    const items: { label: string; met: boolean; options?: Record<string, number> }[] = [];
+    if (policy.min_length > 0) {
+        items.push({ label: "At least {{len}} characters", met: password.length >= policy.min_length, options: { len: policy.min_length } });
+    }
+    if (policy.max_length > 0) {
+        items.push({ label: "At most {{len}} characters", met: password.length <= policy.max_length, options: { len: policy.max_length } });
+    }
+    if (policy.require_lowercase) items.push({ label: "One lowercase letter", met: /[a-z]/.test(password) });
+    if (policy.require_uppercase) items.push({ label: "One uppercase letter", met: /[A-Z]/.test(password) });
+    if (policy.require_number) items.push({ label: "One number", met: /\d/.test(password) });
+    if (policy.require_special) items.push({ label: "One special character", met: /[^a-z0-9]/i.test(password) });
+    return items;
+};
