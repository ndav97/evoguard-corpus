+}
+
+const readLastOffset = (): LastOffset | null => {
+  try {
+    const raw = window.localStorage.getItem(LAST_OFFSET_KEY);
+    if (!raw) {
+      return null;
+    }
+    const value = JSON.parse(raw) as Partial<LastOffset>;
+    if (
+      typeof value.positive !== "boolean" ||
+      typeof value.total !== "number" ||
+      !Number.isInteger(value.total) ||
+      value.total <= 0
+    ) {
+      return null;
+    }
+    return { positive: value.positive, total: value.total };
+  } catch {
+    return null;
+  }
+};
