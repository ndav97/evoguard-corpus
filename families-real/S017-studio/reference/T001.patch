+// The site's own address typed without a scheme ("localhost:8881/about/") is a path on the site.
+function getPathFromSiteHost( value: string, siteUrl: string ): string | null {
+	let host: string;
+	try {
+		host = new URL( siteUrl ).host.toLowerCase();
+	} catch {
+		return null;
+	}
+	if ( ! host || ! value.toLowerCase().startsWith( host ) ) {
+		return null;
+	}
+	const rest = value.slice( host.length );
+	if ( rest === '' ) {
+		return '/';
+	}
+	if ( rest.startsWith( '/' ) ) {
+		return rest;
+	}
+	if ( rest.startsWith( '?' ) || rest.startsWith( '#' ) ) {
+		return `/${ rest }`;
+	}
+	return null;
+}
+
