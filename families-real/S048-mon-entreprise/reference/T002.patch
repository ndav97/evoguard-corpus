+// Matches pattern segments against path segments. Optional parameters
+// (":name?") may be skipped; the first way of matching wins.
+function matchSegments(
+	patternParts: string[],
+	pathParts: string[]
+): Record<string, string> | null {
+	if (patternParts.length === 0) {
+		return pathParts.length === 0 ? {} : null
 	}
 
-	const params: Record<string, string> = {}
+	const [part, ...restPattern] = patternParts
+	const isParam = part.startsWith(':')
+	const isOptional = isParam && part.endsWith('?')
 
-	for (let i = 0; i < patternParts.length; i++) {
-		if (patternParts[i].startsWith(':')) {
-			params[patternParts[i].slice(1)] = decodeSegment(pathParts[i])
-		} else if (patternParts[i] !== decodeSegment(pathParts[i])) {
-			return null
+	if (pathParts.length > 0) {
+		const segment = decodeSegment(pathParts[0])
+		const restPath = pathParts.slice(1)
+		if (isParam) {
+			const rest = matchSegments(restPattern, restPath)
+			if (rest) {
+				const name = part.slice(1, isOptional ? -1 : undefined)
+				return { [name]: segment, ...rest }
+			}
+		} else if (part === segment) {
+			return matchSegments(restPattern, restPath)
 		}
 	}
 
-	return { params }
+	return isOptional ? matchSegments(restPattern, pathParts) : null
 }
 
