+    urlKey ? readPositiveIntParam(`${urlKey}.perPage`) ?? initialPerPage : initialPerPage,
+  );
   const lastPage = Math.max(1, Math.ceil(itemCount / perPage));
 
   React.useEffect(() => {
     setPage((currentPage) => Math.min(currentPage, lastPage));
