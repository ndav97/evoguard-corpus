diff --git a/src/shared/utils/roundNumber.ts b/src/shared/utils/roundNumber.ts
index f9269f1a..ad73d9cd 100644
--- a/src/shared/utils/roundNumber.ts
+++ b/src/shared/utils/roundNumber.ts
@@ -63,3 +63,29 @@ export const formatCount = (
   options: RoundNumberOptions = {}
 ): string =>
   `${roundNumber(value, 1, options)} ${Math.abs(value) === 1 ? singular : plural}`;
+
+const UNIT_MULTIPLIERS = new Map([
+  ['', 1],
+  ['k', 1e3],
+  ['m', 1e6],
+  ['b', 1e9],
+]);
+
+/**
+ * Reads an abbreviated number such as the ones produced by roundNumber
+ * ("12k", "1.5M", "-2k", "1,000B"). Returns null if the text is not one.
+ */
+export const parseRoundedNumber = (text: string): number | null => {
+  const match = /^(-?)(\d{1,3}(?:,\d{3})+|\d+)(?:\.(\d+))?\s*([kmb]?)$/i.exec(
+    (text ?? '').trim()
+  );
+  if (!match) {
+    return null;
+  }
+  const [, sign, integer, fraction = '', unit] = match;
+  const number = Number(`${integer.replaceAll(',', '')}.${fraction || '0'}`);
+  const result = number * (UNIT_MULTIPLIERS.get(unit.toLowerCase()) ?? 1);
+  // Avoid floating point noise such as 1.1k = 1100.0000000000002
+  const rounded = Math.round(result * 1e6) / 1e6;
+  return sign && rounded !== 0 ? -rounded : rounded;
+};
