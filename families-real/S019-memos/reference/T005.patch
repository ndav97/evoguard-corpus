+/**
+ * Storage used against an optional quota: "1.5 MB of 10.0 MB (15%)".
+ * Without a usable quota (missing, not finite or under one byte) only the used size is shown.
+ */
+export function formatStorageUsage(used: number, quota?: number, options: FormatFileSizeOptions = {}): string {
+  const usedLabel = formatFileSize(used, options);
+  if (usedLabel === "Invalid size" || quota === undefined || !Number.isFinite(quota) || Math.floor(quota) <= 0) {
+    return usedLabel;
+  }
+  const percent = Math.round((Math.floor(used) / Math.floor(quota)) * 100);
+  return `${usedLabel} of ${formatFileSize(quota, options)} (${percent}%)`;
+}
