+// La vista se recuerda por watchlist: cada widget configurado tiene su propia clave.
+// Sin watchlist no hay identidad estable y no se guarda nada.
+export const viewStorageKey = (watchlist) => `homepage-stocks-view:${watchlist}`;
+
+function readStoredView(watchlist) {
+  if (!watchlist) return null;
+  try {
+    return typeof window !== "undefined" ? window.localStorage.getItem(viewStorageKey(watchlist)) : null;
+  } catch {
+    return null;
+  }
+}
+
+function storeView(watchlist, view) {
+  if (!watchlist) return;
+  try {
+    window.localStorage.setItem(viewStorageKey(watchlist), view);
+  } catch {
+    // Almacenamiento no disponible (modo privado, cuota…): la vista simplemente no se recuerda.
+  }
+}
+
 const displayTicker = (stock) => stock.ticker.split(":").pop();
 
