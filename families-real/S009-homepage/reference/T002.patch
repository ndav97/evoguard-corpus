+const displayTicker = (stock) => stock.ticker.split(":").pop();
+
+// Ordena una copia de las cotizaciones según options.sort ("ticker" o "change").
+// Cualquier otro valor conserva el orden de la API.
+export function sortStocks(stocks, sort) {
+  const list = (stocks ?? []).filter(Boolean);
+  if (sort === "ticker") {
+    return [...list].sort((a, b) =>
+      displayTicker(a).localeCompare(displayTicker(b), undefined, { sensitivity: "base" }),
+    );
+  }
+  if (sort === "change") {
+    return [...list].sort((a, b) => {
+      const aNull = a.percentChange === null || a.percentChange === undefined;
+      const bNull = b.percentChange === null || b.percentChange === undefined;
+      if (aNull || bNull) return Number(aNull) - Number(bNull);
+      return b.percentChange - a.percentChange;
+    });
+  }
+  return list;
+}
