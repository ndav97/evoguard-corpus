+
+export interface Size {
+  width: number;
+  height: number;
+}
+
+/**
+ * Like autoVideoFit, but from the sizes of the video and the tile. Also
+ * reports how much of the video is cut off with the chosen fit.
+ */
+export function computeVideoFit(
+  videoSize: Size | null | undefined,
+  tileSize: Size | null | undefined,
+  options: AutoVideoFitOptions = {},
+): { fit: "cover" | "contain"; cropFraction: number } {
+  const videoAspectRatio = videoSize
+    ? videoSize.width / videoSize.height
+    : NaN;
+  const tileAspectRatio = tileSize ? tileSize.width / tileSize.height : NaN;
+
+  const fit = autoVideoFit(videoAspectRatio, tileAspectRatio, options);
+  const cropFraction =
+    fit === "cover" ? videoCropFraction(videoAspectRatio, tileAspectRatio) : 0;
+
+  return { fit, cropFraction };
+}
