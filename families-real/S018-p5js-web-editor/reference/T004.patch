+/**
+ * While the user hovers or focuses the toast, it does not hide automatically.
+ */
+export function pauseToast() {
+  return () => {
+    if (hideTimer) {
+      clearTimeout(hideTimer);
+      hideTimer = null;
+    }
+  };
+}
+
+/**
+ * Restarts the automatic hide with the full time of the toast shown.
+ */
+export function resumeToast() {
+  return (dispatch, getState) => {
+    if (!getState().toast.isVisible) return;
+    if (hideTimer) clearTimeout(hideTimer);
+    hideTimer = setTimeout(() => {
+      hideTimer = null;
+      dispatch(hideToast());
+    }, currentTime);
+  };
+}
