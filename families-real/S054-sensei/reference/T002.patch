+/**
+ * Text that describes the progress to assistive technologies.
+ *
+ * @param {number} totalTasks     Number of tasks.
+ * @param {number} completedTasks Number of completed tasks.
+ *
+ * @return {string} Description of the progress.
+ */
+export const getProgressText = ( totalTasks, completedTasks ) => {
+	if ( ! ( totalTasks > 0 ) ) {
+		return __( 'No tasks yet', 'sensei-lms' );
+	}
+
+	const completed = Number.isFinite( completedTasks )
+		? Math.min( Math.max( Math.round( completedTasks ), 0 ), totalTasks )
+		: 0;
+
+	return sprintf(
+		// translators: %1$d: number of completed tasks, %2$d: number of tasks.
+		_n(
+			'%1$d of %2$d task completed',
+			'%1$d of %2$d tasks completed',
+			totalTasks,
+			'sensei-lms'
+		),
+		completed,
+		totalTasks
+	);
+};
