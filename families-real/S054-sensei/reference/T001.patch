 import { __ } from '@wordpress/i18n';
 
+/**
+ * Completed percentage, rounded, between 0 and 100. Without tasks it is 0.
+ *
+ * @param {number} totalTasks     Number of tasks.
+ * @param {number} completedTasks Number of completed tasks.
+ *
+ * @return {number} Percentage.
+ */
+export const getProgressPercentage = ( totalTasks, completedTasks ) => {
+	if ( ! ( totalTasks > 0 ) || ! Number.isFinite( completedTasks ) ) {
+		return 0;
+	}
+
+	const percentage = Math.round( ( completedTasks / totalTasks ) * 100 );
+
+	return Math.min( Math.max( percentage, 0 ), 100 );
+};
