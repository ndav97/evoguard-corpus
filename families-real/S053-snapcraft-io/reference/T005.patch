+export type GitHost = "GitHub" | "GitLab" | "Bitbucket";
+
+const GITLAB_REPOSITORY_PATTERN =
+  /^(?:(?:https?:\/\/)?(?:www\.)?gitlab\.com\/|git@gitlab\.com:)((?:[\w.-]+\/)+[\w.-]+?)(?:\.git)?\/?$/i;
+const BITBUCKET_REPOSITORY_PATTERN =
+  /^(?:(?:https?:\/\/)?(?:www\.)?bitbucket\.org\/|git@bitbucket\.org:)([\w.-]+\/[\w.-]+?)(?:\.git)?\/?$/i;
+
+const hasDotSegments = (path: string) =>
+  path.split("/").some((part) => part === "." || part === "..");
+
+/**
+ * Creates the URL of a commit on GitHub, GitLab or Bitbucket
+ * @param repository - A GitHub reference (see normalizeGitHubRepository),
+ * or a gitlab.com / bitbucket.org URL or SSH remote
+ * @param commitId - The git commit ID
+ * @returns The URL and the host name, or null if invalid
+ */
+export function createCommitUrl(
+  repository?: string | null,
+  commitId?: string | null,
+): { url: string; host: GitHost } | null {
+  const normalizedCommitId = normalizeCommitId(commitId);
+  if (!repository || typeof repository !== "string" || !normalizedCommitId) {
+    return null;
+  }
+
+  const trimmed = repository.trim();
+
+  const gitlab = GITLAB_REPOSITORY_PATTERN.exec(trimmed);
+  if (gitlab) {
+    return hasDotSegments(gitlab[1])
+      ? null
+      : {
+          url: `https://gitlab.com/${gitlab[1]}/-/commit/${normalizedCommitId}`,
+          host: "GitLab",
+        };
+  }
+
+  const bitbucket = BITBUCKET_REPOSITORY_PATTERN.exec(trimmed);
+  if (bitbucket) {
+    return hasDotSegments(bitbucket[1])
+      ? null
+      : {
+          url: `https://bitbucket.org/${bitbucket[1]}/commits/${normalizedCommitId}`,
+          host: "Bitbucket",
+        };
+  }
+
+  // A GitLab or Bitbucket reference that did not match is not a GitHub one
+  if (/^(?:https?:\/\/|git@)?(?:www\.)?(?:gitlab\.com|bitbucket\.org)\b/i.test(trimmed)) {
+    return null;
+  }
+
+  const githubUrl = createGitHubCommitUrl(trimmed, normalizedCommitId);
+  return githubUrl ? { url: githubUrl, host: "GitHub" } : null;
+}
