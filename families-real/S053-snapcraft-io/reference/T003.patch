+const GITHUB_REPOSITORY_PATTERN =
+  /^(?:(?:https?:\/\/)?(?:www\.)?github\.com\/|git@github\.com:)?([\w.-]+)\/([\w.-]+?)(?:\.git)?\/?$/i;
+
+/**
+ * Normalizes a GitHub repository reference to the "owner/repo" format
+ * @param githubRepository - "owner/repo", a github.com URL or an SSH remote
+ * @returns "owner/repo" or null if it is not a GitHub repository reference
+ */
+export function normalizeGitHubRepository(
+  githubRepository?: string | null,
+): string | null {
+  if (!githubRepository || typeof githubRepository !== "string") {
+    return null;
+  }
+
+  const match = GITHUB_REPOSITORY_PATTERN.exec(githubRepository.trim());
+  if (!match) {
+    return null;
+  }
+
+  const [, owner, repo] = match;
+  if ([owner, repo].some((part) => part === "." || part === "..")) {
+    return null;
+  }
+
+  return `${owner}/${repo}`;
+}
