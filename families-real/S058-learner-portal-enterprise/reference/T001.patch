+/**
+ * Compares two times so that valid times go in ascending order and invalid
+ * ones (NaN) go last.
+ */
+const compareTimesAscending = (a, b) => {
+  if (Number.isNaN(a) || Number.isNaN(b)) {
+    return Number.isNaN(a) - Number.isNaN(b);
+  }
+  return a - b;
+};
