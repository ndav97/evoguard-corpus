{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evoguard.invalid/schema/requirement.schema.json",
  "title": "requirement",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "introduced_at": {
      "enum": [
        "V0",
        "T001",
        "T002",
        "T003"
      ]
    },
    "status": {
      "const": "active"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}-A[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ui_contract": {
      "type": "object",
      "description": "Contrato de interfaz observable que el constructor debe respetar y que usa el adaptador del oráculo. Se introduce con el requisito; no revela casos del oráculo.",
      "properties": {
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "searchbox",
                  "combobox",
                  "button",
                  "listitem",
                  "status",
                  "textbox",
                  "checkbox",
                  "spinbutton",
                  "radio",
                  "alert",
                  "heading",
                  "list",
                  "field"
                ],
                "description": "Rol ARIA. field: control localizado por su etiqueta (<label>) cuando el tipo de input no tiene rol ARIA (password, date)."
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rule": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "name",
              "rule"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "initial_state",
        "elements"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "introduced_at",
    "status",
    "description",
    "acceptance",
    "ui_contract"
  ],
  "additionalProperties": false
}
