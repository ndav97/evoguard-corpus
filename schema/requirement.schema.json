{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evoguard.invalid/schema/requirement.schema.json",
  "title": "requirement",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "introduced_at": {
      "enum": [
        "V0",
        "T001",
        "T002",
        "T003"
      ]
    },
    "status": {
      "const": "active"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}-A[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "introduced_at",
    "status",
    "description",
    "acceptance"
  ],
  "additionalProperties": false
}
