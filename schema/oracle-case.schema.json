{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evoguard.invalid/schema/oracle-case.schema.json",
  "title": "oracle-case",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "minimum_version": {
      "enum": [
        "V0",
        "V1",
        "V2",
        "V3"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}-A[0-9]{2}$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "steps",
          "expected"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "requirement_id",
    "minimum_version",
    "cases"
  ],
  "additionalProperties": false
}
